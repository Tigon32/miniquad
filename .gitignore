/target
**/*.rs.bk
Cargo.lock
node_modules/
/test-results/
/.local-ci/

# Scratch fixtures written and removed by tests/starter-generator.test.mjs.
/.generator-test-scratch/

# Keep the standalone example reproducible.
!examples/ime_demo/Cargo.lock
/examples/ime_demo/target/

# Keep the pinned-Lyon benchmark-only comparison reproducible (issue
# #123): this is the one isolated bench project the user approved the
# pinned-dependency exception for. See docs/drawing-companion.md.
!experiments/drawing-comparison/Cargo.lock

# Keep the issue #123 external-consumer fixture (a separate crate that
# depends on the miniquad-draw companion via a path/Git dependency, not
# a copy of its source) reproducible too. See docs/drawing-companion.md.
!experiments/drawing-comparison/external-consumer/Cargo.lock

# WebGPU proof candidates (#154): keep their pinned locks, ignore build output.
!experiments/webgpu-manual/Cargo.lock
!experiments/webgpu-wgpu/Cargo.lock
/experiments/webgpu-*/target/
/experiments/webgpu-*/dist/
