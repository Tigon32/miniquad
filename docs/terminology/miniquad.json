      "kind": "technical-noun",
      "aliases": [
        "game"
      ],
      "related": [
        "miniquad:library"
      ]
    },
    {
      "id": "miniquad:backend",
      "term": "platform backend",
      "definition": "Code that connects Miniquad to a specific operating system or graphics API.",
      "kind": "technical-noun",
      "related": [
        "miniquad:graphics-context"
      ]
    },
    {
      "id": "miniquad:WASM",
      "term": "WebAssembly module",
      "definition": "A compiled module that a WebAssembly runtime can execute.",
