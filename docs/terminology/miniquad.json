  "concepts": [
    {
      "id": "miniquad:library",
      "term": "Miniquad",
      "definition": "A Rust library that provides window, input, and graphics functions for different platforms.",
      "kind": "technical-noun",
      "related": [
        "miniquad:backend"
      ]
    },
    {
      "id": "miniquad:application",
      "term": "game application",
