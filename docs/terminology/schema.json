{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project technical terminology",
  "description": "Project-authored glossary extension. It does not reproduce the ASD-STE100 dictionary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "version",
    "source",
    "concepts"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "term",
          "definition",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "term": {
            "type": "string",
            "minLength": 2
          },
          "definition": {
            "type": "string",
            "minLength": 10
          },
          "kind": {
            "enum": [
              "technical-noun",
              "technical-verb"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "broader": {
            "type": "string"
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
