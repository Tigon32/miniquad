{
  "name": "miniquad-js-tooling",
  "private": true,
  "description": "Development-only linting for Miniquad's browser bridge",
  "scripts": {
    "ci:local": "node scripts/local-ci.mjs",
    "ci:local:gh": "node scripts/local-ci.mjs --runner gh-act",
    "lint:js": "eslint js/gl.js js/*.mjs",
    "test:browser": "playwright test",
    "test:browser:chromium": "playwright test --project=chromium"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "@playwright/test": "1.65.0",
    "pngjs": "7.0.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
